{
  "name": "dekereke-sync-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Dekereke Companion Suite engine: enrollment, metadata and relay only (decision D5) — no user blobs.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --platform=neutral --conditions=workerd",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "esbuild": "^0.24.0",
    "miniflare": "^3.20241106.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}
